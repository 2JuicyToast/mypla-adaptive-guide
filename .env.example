# Optional local Supabase connection. Leave both blank to use in-memory demo data.
# The backend requires a signed-in user's Bearer token before using Supabase.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional server-side task parsing. In Replit, store the key as a Secret.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free